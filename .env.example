# Copy to .dev.vars for local Worker bindings. Never commit credentials.
# Activate Google Places API (New), restrict the key, configure the real Place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Sending is enabled only with BOTH values. Use a verified domain for the sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Home3 on GitHub Pages: paste the REAL Formspree /f/ endpoint after creating
# one form with verified recipient info@mouline.be. No placeholder ID is shipped.
# Set this same public value in GitHub Actions Variables before building Pages.
# Keep Formspree spam filtering enabled; the form includes its _gotcha honeypot.
# Never put SMTP/API credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_CONTACT_ENDPOINT=
