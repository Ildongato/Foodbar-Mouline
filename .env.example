# Copy to .dev.vars for local Worker bindings. Never commit credentials.
# Activate Google Places API (New), restrict the key, configure the real Place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Sending is enabled only with BOTH values. Use a verified domain for the sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional legacy GitHub Pages endpoint; never put SMTP/API credentials here.
# DirectAdmin test builds always use /nieuw/api/contact.php and hosting mail().
# See hosting/DEPLOYMENT.md. No external form provider is needed on DirectAdmin.
NEXT_PUBLIC_CONTACT_ENDPOINT=
